# Copy file này thành .env rồi đổi giá trị (KHÔNG commit .env — đã có trong .gitignore).
# Mọi giá trị dưới đây là GIẢ, chỉ dùng cho máy dev.
# Đổi mật khẩu ở đây thì nhớ đổi cả ConnectionStrings:CyberCafe (appsettings.Development.json hoặc user-secrets).
MSSQL_SA_PASSWORD=Fake_Passw0rd_ChangeMe
MSSQL_PORT=1434
# Buổi 42–47: Redis (Api đọc ConnectionStrings:Redis = localhost:6380 trong appsettings.Development.json)
REDIS_PORT=6380
