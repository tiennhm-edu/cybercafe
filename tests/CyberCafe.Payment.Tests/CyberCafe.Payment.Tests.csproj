<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test cho Payment service (Buổi 55): luật thanh toán (C# thuần) + consumer idempotent.
    KHÔNG cần Docker/RabbitMQ: MassTransit test harness (có sẵn trong gói MassTransit 8, Apache-2.0) chạy bus
    trong bộ nhớ; EF Core InMemory thay SQL Server.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CyberCafe.Payment.Api\CyberCafe.Payment.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
