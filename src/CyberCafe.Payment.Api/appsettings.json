// ============================================================================
// appsettings.json — Payment service (Buổi 54–55). File cấu hình .NET cho phép chú thích // như thế này.
// Connection string để TRỐNG: dưới AppHost, Aspire bơm qua biến môi trường
//   ConnectionStrings__PaymentDb  (database riêng CyberCafePayments trên container SQL Server)
//   ConnectionStrings__messaging  (RabbitMQ amqp://...)
// Thiếu "messaging" → MassTransit dùng bus trong bộ nhớ (chỉ hữu ích cho test).
// ============================================================================
{
  "ConnectionStrings": {
    "PaymentDb": "",
    "messaging": ""
  },
  // Luật thanh toán GIẢ LẬP (không gọi cổng thanh toán thật) — đổi số ở đây để demo các kịch bản thất bại
  "Payment": {
    // Đơn vượt số này (VND) → PaymentFailed "Vượt hạn mức" → Order service hủy đơn
    "MaxAmount": 500000,
    // Thẻ có 4 số cuối như thế này → "Ngân hàng từ chối" (demo: thẻ 4111 1111 1111 0000)
    "DeclinedCardSuffix": "0000",
    // Chờ giả lập (ms) để lớp kịp thấy trạng thái "Đang xử lý thanh toán" trên trang khách
    "SimulatedDelayMs": 0
  },
  "Database": {
    // AppHost đặt Database__MigrateOnStartup=true: container SQL mới tinh → tự tạo bảng khi khởi động
    "MigrateOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
