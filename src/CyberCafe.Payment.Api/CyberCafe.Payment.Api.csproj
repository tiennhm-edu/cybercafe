<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    CyberCafe.Payment.Api (Buổi 54–55): SERVICE THANH TOÁN tách khỏi khối Api — minimal API + consumer RabbitMQ.
      Data/        PaymentDbContext: database RIÊNG (CyberCafePayments) — Payments + ProcessedMessages, migration riêng
      Processing/  PaymentRules: luật giả lập (vượt hạn mức → từ chối; thẻ đuôi 0000 → ngân hàng từ chối)
      Messaging/   OrderPlacedConsumer (idempotent) → publish PaymentCompleted / PaymentFailed
      Endpoints/   GET /payments, GET /payments/orders/{orderId} (đi qua gateway, chỉ Admin)
    Luật ranh giới (architecture test kiểm tra): CHỈ tham chiếu CyberCafe.IntegrationEvents (hợp đồng message)
    + CyberCafe.ServiceDefaults (hạ tầng chung). KHÔNG Domain / Contracts / Application / Infrastructure của Order.
    Version package nằm trong Directory.Packages.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>cybercafe-payment-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Design: chỉ cho lệnh dotnet ef migrations (startup project = chính service này) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- MassTransit 8.x (Apache-2.0) + RabbitMQ transport — KHÔNG nâng lên 9.x (thương mại), xem ADR 0004 -->
    <PackageReference Include="MassTransit.RabbitMQ" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CyberCafe.IntegrationEvents\CyberCafe.IntegrationEvents.csproj" />
    <ProjectReference Include="..\CyberCafe.ServiceDefaults\CyberCafe.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
