<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    CyberCafe.Api (Buổi 32–41): ASP.NET Core Web API (controllers) + EF Core SQL Server + SignalR.
    Buổi 42–47: JWT + BCrypt, Redis cache, rate limiting (có sẵn trong ASP.NET Core, không cần package).
    Buổi 48 (Clean Architecture): Api chỉ còn là "cửa vào" — controller mỏng, hub, middleware, filter
    + COMPOSITION ROOT (Program.cs gọi AddApplication / AddInfrastructure). Không còn DbContext, Migrations ở đây.
    Buổi 54–55 (microservice): Api trở thành "Order service" (+ Menu + Identity) — 1 trong các service do Aspire AppHost
    điều phối; tham chiếu ServiceDefaults (OpenTelemetry, health check, service discovery, resilience).
    Payment đã tách ra CyberCafe.Payment.Api; 2 bên nói chuyện qua RabbitMQ (Infrastructure/Messaging).
    Version package nằm trong Directory.Packages.props (Central Package Management).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- user-secrets: dotnet user-secrets set "ConnectionStrings:CyberCafe" "..." (thay cho appsettings khi làm thật) -->
    <UserSecretsId>cybercafe-api</UserSecretsId>
    <!-- Sinh file XML từ /// <summary> → OpenAPI (Scalar) hiện mô tả tiếng Việt cho từng endpoint -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: thiếu /// trên member public. Không bắt buộc với migration do EF sinh ra. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Buổi 42–47: middleware KIỂM TRA JWT ở cửa vào (phát JWT thì ở Infrastructure/Identity) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Buổi 48: EF Core SqlServer, BCrypt, Redis chuyển sang CyberCafe.Infrastructure.csproj -->
    <!-- Design: chỉ dùng lúc chạy lệnh dotnet ef (Api là STARTUP project: -s src/CyberCafe.Api), không đóng gói vào app -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CyberCafe.Application\CyberCafe.Application.csproj" />
    <!-- Tham chiếu Infrastructure CHỈ để Program.cs gọi AddInfrastructure() (composition root).
         Controller không được dùng thẳng class nào của Infrastructure — architecture test kiểm tra. -->
    <ProjectReference Include="..\CyberCafe.Infrastructure\CyberCafe.Infrastructure.csproj" />
    <!-- Buổi 54: cấu hình chung của mọi service (builder.AddServiceDefaults()) -->
    <ProjectReference Include="..\CyberCafe.ServiceDefaults\CyberCafe.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
