// Buổi 32–41: địa chỉ Api khi chạy lẻ (dotnet run). Buổi 54: dưới AppHost, Aspire ghi đè bằng biến môi trường
//   ApiBaseUrl=http://gateway/ (service discovery) và HubBaseUrl=<địa chỉ thật của gateway> (SignalR).
{
  "ApiBaseUrl": "http://localhost:5180/",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
