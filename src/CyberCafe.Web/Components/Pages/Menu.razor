@* ==========================================================================
   Menu.razor — trang Thực đơn (Buổi 23 tạo · Buổi 24–31 nâng cấp).
   Buổi 23: @inject service, @foreach hiển thị danh sách.
   Buổi 24–31: tách card thành component con <ProductCard>, nhận sự kiện
   "thêm vào giỏ" qua EventCallback, lọc bằng @bind / @bind:event, ghi vào
   CartState, và quan sát LIFECYCLE (OnInitializedAsync, OnAfterRender, Dispose).
   Buổi 32–35: dữ liệu lấy từ CyberCafe.Api qua MenuApiClient (typed HttpClient) thay cho
   MenuService in-memory — markup gần như giữ nguyên vì client trả về đúng domain Product.
   ========================================================================== *@
@page "/menu"
@* @implements IDisposable: Blazor sẽ gọi Dispose() khi component bị bỏ (rời trang). *@
@implements IDisposable
@* @inject <Kiểu> <TênBiến>: xin DI container 1 instance (đã đăng ký trong Program.cs).
   ⚠️ Lỗi hay gặp: quên AddSingleton/AddScoped trong Program.cs → lỗi lúc chạy
   "Cannot provide a value for property 'MenuApi'... no registered service". *@
@inject MenuApiClient MenuApi
@inject CartState CartState
@* ILogger<Menu>: ghi log ra console — dùng để quan sát thứ tự các hàm lifecycle. *@
@inject ILogger<Menu> Logger

<PageTitle>CyberCafe — Thực đơn</PageTitle>

<h1>Thực đơn</h1>

@if (_error is not null)
{
    @* Lỗi gọi API (API chưa chạy, SQL Server chưa bật...) → báo rõ + cho thử lại, không văng trang lỗi *@
    <div class="alert alert-danger">
        @_error
        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadAsync">Thử lại</button>
    </div>
}
else if (_products is null)
{
    @* Lần render đầu: OnInitializedAsync chưa xong → hiện loading *@
    <p><span class="spinner-border spinner-border-sm"></span> Đang tải thực đơn...</p>
}
else
{
    <div class="row g-2 mb-3">
        <div class="col-md-6">
            @* two-way binding + cập nhật theo từng phím gõ (oninput) *@
            @* @bind mặc định cập nhật ở sự kiện "onchange" (khi rời ô / nhấn Enter).
               @bind:event="oninput" → cập nhật _keyword NGAY mỗi phím gõ → danh sách lọc tức thì. *@
            <input class="form-control" placeholder="Tìm món..." @bind="_keyword" @bind:event="oninput" />
        </div>
        <div class="col-md-4">
            @* @bind trên <select>: chọn option → gán value của option vào _category *@
            <select class="form-select" @bind="_category">
                <option value="">Tất cả nhóm</option>
                @foreach (string category in _products.Select(x => x.Category).Distinct())
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success py-2">@_message</div>
    }

    @if (!FilteredProducts.Any())
    {
        <p class="text-muted">Không tìm thấy món phù hợp với "@_keyword".</p>
    }

    @* Bootstrap grid: 1 cột trên điện thoại, 2 cột (md), 4 cột (lg) *@
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
        @foreach (Product product in FilteredProducts)
        {
            @* @key: giúp Blazor nhận diện từng phần tử khi danh sách đổi (lọc/sắp xếp) →
               giữ đúng state nội bộ (size, số lượng đang chọn) của từng ProductCard. *@
            <div class="col" @key="product.Id">
                @* Cha → con: truyền dữ liệu qua [Parameter] Product.
                   Con → cha: con gọi OnAddToCart, cha xử lý ở HandleAddToCart.
                   ⚠️ Lỗi hay gặp: viết OnAddToCart="HandleAddToCart()" (có ngoặc) → gọi hàm ngay lúc render, sai. *@
                <ProductCard Product="product" OnAddToCart="HandleAddToCart" />
            </div>
        }
    </div>

    <p class="mt-4 text-muted">Hiển thị @FilteredProducts.Count() / @_products.Count món.</p>
}

@code {
    // null = chưa tải xong (markup dựa vào đó để hiện "Đang tải...")
    private IReadOnlyList<Product>? _products;
    private string _keyword = string.Empty;
    private string _category = string.Empty;
    private string? _message;
    private string? _error;
    // CancellationTokenSource: cho phép HỦY tác vụ async (Task.Delay) nếu người dùng rời trang giữa chừng
    private readonly CancellationTokenSource _cts = new();

    // Property tính toán: mỗi lần render đọc lại _keyword/_category → không cần tự gọi "lọc lại"
    private IEnumerable<Product> FilteredProducts => (_products ?? [])
        .Where(x => string.IsNullOrEmpty(_category) || x.Category == _category)
        .Where(x => x.Name.Contains(_keyword, StringComparison.OrdinalIgnoreCase));

    // Lifecycle 1: chạy 1 lần khi component khởi tạo — chỗ để load dữ liệu
    // Blazor render 1 lần khi gặp await đầu tiên (lúc này _products còn null → "Đang tải..."),
    // rồi tự render lại khi Task hoàn tất.
    // ⚠️ Vì App.razor bật PRERENDER: hàm này chạy 2 LẦN — 1 lần khi server prerender HTML tĩnh,
    // 1 lần nữa khi circuit SignalR kết nối (component được tạo mới). Bình thường, không phải bug;
    // muốn tránh tải 2 lần thì dùng PersistentComponentState (giới thiệu sau).
    protected override Task OnInitializedAsync() => LoadAsync();

    // Tách thành method riêng để nút "Thử lại" gọi lại được
    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _products = await MenuApi.GetMenuAsync(_cts.Token);
        }
        catch (ApiException ex)
        {
            // ApiClientBase đã đổi lỗi mạng / ProblemDetails thành thông báo tiếng Việt
            _error = ex.Message;
        }
    }

    // Lifecycle 2: chạy SAU mỗi lần render. firstRender = true chỉ ở lần đầu (sau khi circuit kết nối).
    // Chỗ phù hợp để gọi JS interop (DOM đã có). Ở đây chỉ log để quan sát thứ tự lifecycle.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Logger.LogInformation("Menu: first render xong, {Count} món", _products?.Count ?? 0);
        }
    }

    // Được ProductCard gọi qua EventCallback. Sau khi handler của EventCallback chạy xong,
    // Blazor tự gọi StateHasChanged cho component CHA (Menu) → _message hiện ra.
    private void HandleAddToCart(AddToCartArgs args)
    {
        try
        {
            // Ghi vào CartState (scoped) → CartState bắn OnChange → CartSummary trên top-row cập nhật số món
            CartState.AddItem(args.Product, args.Size, args.Quantity);
            string size = args.Product.HasSize ? $" size {args.Size}" : string.Empty;
            _message = $"Đã thêm {args.Quantity} × {args.Product.Name}{size} vào giỏ.";
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            // Domain từ chối (vd món tạm hết) → hiện thông báo thay vì làm crash circuit
            _message = ex.Message;
        }
    }

    // Lifecycle cuối: component bị bỏ (chuyển trang) → dọn dẹp tài nguyên
    public void Dispose()
    {
        // Rời trang khi đang tải → hủy request HTTP đang chờ
        _cts.Cancel();
        _cts.Dispose();
    }
}
