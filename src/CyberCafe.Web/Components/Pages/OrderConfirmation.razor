@* ==========================================================================
   OrderConfirmation.razor — trang xác nhận đơn /orders/{OrderId}
   (Buổi 24–31 · Route parameter + OnParametersSet;
    Buổi 32–35 · đọc đơn từ API; Buổi 33–34 · trạng thái tự cập nhật qua SignalR).
   Khách để trang này mở: barista bấm "Bắt đầu pha" → badge đổi ngay, không cần F5.
   Buổi 42–47: phải đăng nhập; Api/hub chỉ cho xem đơn CỦA MÌNH (đơn người khác → "Không tìm thấy").
   Buổi 55: thanh toán BẤT ĐỒNG BỘ (Payment service qua RabbitMQ) → trang có 3 trạng thái:
     ⏳ đang xử lý thanh toán (Pending, chưa có PaymentText) → 🎉 thành công (nhận "OrderPlaced" qua SignalR)
                                                           → ❌ bị từ chối (nhận "OrderStatusChanged" = Cancelled).
   ========================================================================== *@
@* {OrderId:int}: route parameter có RÀNG BUỘC kiểu — /orders/abc không khớp route → trang NotFound.
   ⚠️ Lỗi hay gặp: đặt tên property khác tên trong {…} (vd Id) → giá trị không được gán. *@
@page "/orders/{OrderId:int}"
@* IAsyncDisposable: trang giữ 1 HubConnection, rời trang phải đóng (DisposeAsync) *@
@implements IAsyncDisposable
@* [Authorize] không kèm role: đăng nhập là đủ vào trang; quyền xem TỪNG đơn do Api quyết định *@
@attribute [Authorize]
@inject OrderApiClient OrderApi
@inject AuthSession Session
@inject OrderHubConnectionFactory HubFactory
@inject ILogger<OrderConfirmation> Logger

@* Order.FormatCode (static, Domain): định dạng CC-0007 giống hệt Api, kể cả khi chưa tải xong đơn *@
<PageTitle>CyberCafe — Đơn @Order.FormatCode(OrderId)</PageTitle>

@* Thứ tự kiểm tra: lỗi gọi API → đang tải → không có đơn (404) → hiển thị đơn *@
@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_loading)
{
    <p><span class="spinner-border spinner-border-sm"></span> Đang tải đơn...</p>
}
else if (_order is null)
{
    <h1>Không tìm thấy đơn</h1>
    <p>Không có đơn hàng mã <code>@Order.FormatCode(OrderId)</code>.</p>
    <a href="menu">Về thực đơn</a>
}
else
{
    @* 👉 Bước 8 (b55.md): PaymentText null = Payment service chưa trả lời (hoặc đã từ chối) *@
    @if (_order.PaymentText is null && _order.Status == OrderStatus.Pending)
    {
        <div class="alert alert-info">
            <h1 class="h4 alert-heading mb-1"><span class="spinner-border spinner-border-sm"></span> Đang xử lý thanh toán...</h1>
            Đơn <strong>@_order.Code</strong> đã được ghi nhận. Trang tự cập nhật khi có kết quả — không cần tải lại.
        </div>
    }
    else if (_order.PaymentText is null && _order.Status == OrderStatus.Cancelled)
    {
        <div class="alert alert-danger">
            <h1 class="h4 alert-heading mb-1">❌ Thanh toán không thành công</h1>
            Đơn <strong>@_order.Code</strong> đã bị hủy, bạn chưa bị trừ tiền. Vui lòng thử hình thức thanh toán khác.
        </div>
    }
    else
    {
        <div class="alert alert-success">
            <h1 class="h4 alert-heading mb-1">🎉 Đặt hàng thành công!</h1>
            Mã đơn <strong>@_order.Code</strong> — vui lòng đọc mã này khi nhận món tại quầy.
        </div>
    }

    <dl class="row">
        <dt class="col-sm-3">Khách hàng</dt>
        <dd class="col-sm-9">@_order.CustomerName - @_order.PhoneNumber</dd>
        <dt class="col-sm-3">Thời gian</dt>
        <dd class="col-sm-9">@_order.CreatedAt.ToString("HH:mm dd/MM/yyyy")</dd>
        <dt class="col-sm-3">Trạng thái</dt>
        <dd class="col-sm-9">
            <OrderStatusBadge Status="_order.Status" />
            @* Cho khách biết trang đang "nghe" realtime hay không *@
            <small class="text-muted ms-2">@(_live ? "🟢 cập nhật trực tiếp" : "⚪ không có cập nhật trực tiếp")</small>
        </dd>
        @if (_order.Note is not null)
        {
            <dt class="col-sm-3">Ghi chú</dt>
            <dd class="col-sm-9">@_order.Note</dd>
        }
        @if (_order.PaymentText is not null)
        {
            <dt class="col-sm-3">Thanh toán</dt>
            @* PaymentText do API tạo bằng Payment.Display() đa hình (Cash/Card/Momo) *@
            <dd class="col-sm-9">@_order.PaymentText</dd>
        }
    </dl>

    @* Số tiền lấy nguyên từ DTO (server đã tính) — trang không tự cộng lại *@
    <table class="table">
        <tbody>
            @foreach (OrderItemDto item in _order.Items)
            {
                <tr>
                    <td>@item.Emoji @item.ProductName @(item.HasSize ? $"({item.Size})" : "")</td>
                    <td class="text-end">× @item.Quantity</td>
                    <td class="text-end">@item.LineTotal.ToString("N0") đ</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr><td colspan="2">Tạm tính</td><td class="text-end">@_order.TotalAmount.ToString("N0") đ</td></tr>
            @if (_order.DiscountText is not null)
            {
                <tr><td colspan="2">@_order.DiscountText</td><td class="text-end">-@_order.DiscountAmount.ToString("N0") đ</td></tr>
            }
            <tr class="fw-bold"><td colspan="2">Tổng cộng</td><td class="text-end">@_order.FinalAmount.ToString("N0") đ</td></tr>
        </tfoot>
    </table>

    <p>Điểm tích lũy hiện có: <strong>@_order.LoyaltyPoints</strong></p>
    <a class="btn btn-primary" href="menu">Đặt thêm món</a>
}

@code {
    // Route parameter: /orders/7 → OrderId = 7 (đã được ràng buộc :int nên chắc chắn là số)
    [Parameter]
    public int OrderId { get; set; }

    private OrderDto? _order;
    private bool _loading = true;
    private string? _error;
    private HubConnection? _hub;
    // true khi đã vào group order-{id} → badge "cập nhật trực tiếp"
    private bool _live;
    // Đơn đang theo dõi trên hub (để biết khi nào cần WatchOrder lại)
    private int _watchingId;

    // OnParametersSetAsync: chạy lần đầu VÀ mỗi khi OrderId đổi (vd /orders/7 → /orders/8 trên cùng component)
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _order = await OrderApi.GetByIdAsync(OrderId); // 404 → null → "Không tìm thấy đơn"
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }

        // Đã có kết nối realtime mà người dùng chuyển sang đơn khác → theo dõi đơn mới
        if (_hub?.State == HubConnectionState.Connected && _watchingId != OrderId)
        {
            await WatchCurrentOrderAsync();
        }
    }

    // 👉 Bước 12 (b40.md): mở kết nối SignalR ở OnAfterRenderAsync(firstRender) chứ không ở OnInitializedAsync:
    // OnAfterRender CHỈ chạy khi component đã interactive (không chạy lúc prerender) → không mở kết nối "thừa"
    // cho bản HTML tĩnh sẽ bị bỏ đi ngay sau đó.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _hub = HubFactory.Create(() => Session.GetAccessTokenAsync()); // hub đòi JWT (Buổi 42–47)

        // Sự kiện đến trên luồng của SignalR, KHÔNG phải luồng của Blazor → bọc InvokeAsync rồi mới StateHasChanged
        _hub.On<OrderDto>(OrderHubContract.OrderStatusChanged, updated => InvokeAsync(() => ApplyUpdate(updated)));
        // Buổi 55: thanh toán xong (đến SAU từ Payment service) → Api gửi "OrderPlaced" cho cả group order-{id}
        _hub.On<OrderDto>(OrderHubContract.OrderPlaced, updated => InvokeAsync(() => ApplyUpdate(updated)));

        // Reconnect = ConnectionId MỚI = mất group cũ → xin vào group order-{id} lại
        _hub.Reconnected += _ => WatchCurrentOrderAsync();
        _hub.Reconnecting += _ => InvokeAsync(() => { _live = false; StateHasChanged(); });

        try
        {
            await _hub.StartAsync();
            await WatchCurrentOrderAsync();
        }
        catch (Exception ex)
        {
            // Bắt mọi lỗi (API tắt, WebSocket bị chặn...): hub lỗi không làm hỏng trang: khách vẫn xem được đơn, chỉ mất phần "tự cập nhật"
            Logger.LogWarning(ex, "Không kết nối được OrderHub");
        }
    }

    // Nhận bản đơn mới từ hub (chỉ khi đúng đơn đang xem)
    private void ApplyUpdate(OrderDto updated)
    {
        if (updated.Id == OrderId)
        {
            _order = updated;
            StateHasChanged();
        }
    }

    private async Task WatchCurrentOrderAsync()
    {
        if (_hub is null)
        {
            return;
        }

        // InvokeAsync(tên method trên hub, tham số...) — client GỌI method của server
        await _hub.InvokeAsync(OrderHubContract.WatchOrder, OrderId);
        _watchingId = OrderId;
        await InvokeAsync(() => { _live = true; StateHasChanged(); });
    }

    // IAsyncDisposable: HubConnection.DisposeAsync là async → component phải implement bản async.
    // ⚠️ Lỗi hay gặp: không dispose → mỗi lần vào trang mở thêm 1 kết nối WebSocket "mồ côi" tới Api.
    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
