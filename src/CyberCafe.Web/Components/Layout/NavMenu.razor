@* ==========================================================================
   NavMenu.razor — thanh điều hướng bên trái (Buổi 23 · Routing + NavLink; Buổi 24–31 thêm Giỏ hàng;
   Buổi 32–41 thêm Quầy barista + Quản lý thực đơn — Buổi 42–47 ẩn/hiện theo vai trò bằng <AuthorizeView>;
   Buổi 54 thêm Giao dịch thanh toán — dữ liệu từ Payment service qua gateway).
   ⚠️ Ẩn link KHÔNG phải là bảo mật: người dùng vẫn gõ được URL → trang phải có [Authorize]
      và Api phải kiểm tra quyền. Ẩn link chỉ để giao diện gọn đúng vai trò.
   Mỗi mục là 1 <NavLink> trỏ tới 1 route khai báo bằng @page trong Pages/.
   ========================================================================== *@
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">☕ CyberCafe</a>
    </div>
</div>

@* Checkbox ẩn + CSS (:checked) = nút "hamburger" bật/tắt menu trên màn hình nhỏ, không cần JavaScript. *@
<input type="checkbox" title="Menu điều hướng" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            @* NavLink = thẻ <a> "thông minh": tự thêm class "active" khi URL hiện tại khớp href.
               Match="NavLinkMatch.All": chỉ active khi khớp TOÀN BỘ URL. Trang chủ (href="")
               cần dòng này, nếu không mọi URL đều bắt đầu bằng "" → "Trang chủ" luôn sáng. *@
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Trang chủ
            </NavLink>
        </div>

        <div class="nav-item px-3">
            @* href không có dấu "/" đầu: tương đối với <base href="/"> trong App.razor → /menu *@
            <NavLink class="nav-link" href="menu">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Thực đơn
            </NavLink>
        </div>

        <div class="nav-item px-3">
            @* /cart → CartPage.razor (@page "/cart") *@
            <NavLink class="nav-link" href="cart">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Giỏ hàng
            </NavLink>
        </div>

        @* AuthorizeView Roles="...": chỉ render nội dung khi người dùng có 1 trong các role (dấu phẩy = HOẶC) *@
        <AuthorizeView Roles="@Roles.Customer">
            <div class="nav-item px-3">
                @* /my-orders → MyOrders.razor: chỉ đơn của chính khách (Api lọc theo token) *@
                <NavLink class="nav-link" href="my-orders">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Đơn của tôi
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.Staff">
            <div class="nav-item px-3">
                @* /barista → Barista.razor: nhận đơn realtime qua SignalR *@
                <NavLink class="nav-link" href="barista">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Quầy barista
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.Admin">
            <div class="nav-item px-3">
                @* /admin/menu → Admin/MenuAdmin.razor: CRUD thực đơn qua API *@
                <NavLink class="nav-link" href="admin/menu">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Quản lý thực đơn
                </NavLink>
            </div>
            <div class="nav-item px-3">
                @* /admin/payments → Admin/PaymentsAdmin.razor: Payment service (b54), gateway chỉ cho Admin *@
                <NavLink class="nav-link" href="admin/payments">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Giao dịch thanh toán
                </NavLink>
            </div>
        </AuthorizeView>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Giới thiệu
            </NavLink>
        </div>
    </nav>
</div>
